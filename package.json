{
    "name": "ims-monorepo",
    "version": "1.0.0",
    "description": "Institute Management System - Monorepo with React Native frontend and Python backend",
    "private": true,
    "scripts": {
        "mobile": "cd mobile && npm start",
        "mobile:install": "cd mobile && npm install",
        "backend": "node scripts/backend-python.js run",
        "backend:setup": "node scripts/backend-python.js setup",
        "dev": "concurrently \"npm run mobile\" \"npm run backend\"",
        "install:all": "npm run mobile:install && echo Backend dependencies: run 'npm run backend:setup' to create venv and install Python packages",
        "lint:mobile": "cd mobile && npm run lint"
    },
    "devDependencies": {
        "concurrently": "^9.1.2"
    },
    "keywords": [
        "institute-management",
        "react-native",
        "fastapi",
        "monorepo"
    ],
    "author": "",
    "license": "ISC"
}