# Application Configuration
APP_NAME=IMS Backend
APP_VERSION=1.0.0
DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=postgresql+asyncpg://ims_user:ims_password@localhost:5432/ims_db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_TOKEN_REFRESH_WINDOW_MINUTES=5

# CORS (default local development origins; add exp://... only if using Expo Go tunnel)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8081,http://127.0.0.1:8081,http://localhost:19000,http://localhost:19006

# Logging
LOG_LEVEL=INFO
