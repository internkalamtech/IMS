# Environment: development, staging, production, test
# Defaults to development if not set
EXPO_PUBLIC_ENV=development

# Backend API URL
# - In PRODUCTION/STAGING/TEST: This URL is used directly.
# - In DEVELOPMENT: 
#   - Detects host computer IP for physical devices (Native).
#   - Uses localhost for Web.
#   - Falls back to 10.0.2.2 for Android Emulator.
# Use this variable only to override the detection or set server URL.
# Example for local development with physical device:
# EXPO_PUBLIC_API_URL=http://192.168.1.5:8000/api/v1
EXPO_PUBLIC_API_URL=
